# ==========================================
# Root .gitignore for Flutter Monorepo
# ==========================================

# --- Hệ điều hành & Tệp rác hệ thống ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
*.log
**/promotional/

# --- IDE & Editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-workspace
*.sublime-project
.project
.classpath
.c9/
*.launch
.settings/

# --- Environment & Khóa bảo mật ---
**/.env
**/.env.*
!**/.env.example
**/*.key
**/*.pem
**/*.p12
**/*.jks

# --- Flutter / Dart Root & Nested Subfolders ---
# Dùng **/ để bắt mọi thư mục con ở bất kỳ cấp nào
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/coverage/

# --- Android Artifacts (Nested) ---
**/android/**/gradle-wrapper.jar
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# --- iOS Artifacts (Nested) ---
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/project.xcworkspace/
**/ios/**/xcuserdata/
**/ios/.generated/
**/ios/Pods/
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json

!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# --- Desktop & Web Platforms (Nested) ---
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/web/dart.js
**/web/dart.js.deps

# --- Ngăn chặn lỗi lồng Submodule Git ---
!/.git
**/.git/